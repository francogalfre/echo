{
  "name": "@echo/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./context": {
      "default": "./src/context.ts"
    },
    "./types": {
      "default": "./src/types.ts"
    },
    "./routers/index": {
      "default": "./src/routers/index.ts"
    },
    "./lib/redis": {
      "default": "./src/lib/redis.ts"
    },
    "./schemas": {
      "default": "./src/schemas.ts"
    },
    "./controllers/*": {
      "default": "./src/controllers/*.ts"
    },
    "./jobs/*": {
      "default": "./src/jobs/*.ts"
    },
    "./services/jobs": {
      "default": "./src/services/jobs.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@echo/ai": "workspace:*",
    "@echo/auth": "workspace:*",
    "@echo/db": "workspace:*",
    "@echo/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@echo/config": "workspace:*",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.0"
  }
}
